{
  "name": "dsh-github-push",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把 DSH 写好的代码一键提交到 GitHub 仓库：设置页保存 token/仓库，模型侧工具 github_push 直接走 GitHub API 建提交，不需要本地 git。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "push",
    "upload"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT"
}
